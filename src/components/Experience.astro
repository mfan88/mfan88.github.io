---
import { companies } from '../data/experience';
import Mock from './Mock.astro';
---
<section id="experience" class="exp">
  <h2>Experience</h2>
  {companies.map((company) => (
  <div class="company" id={`exp-${company.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
    <div class="co-main">
    <div class="company-head">
      <h3>{company.name}</h3>
      {company.location && <span class="muted">{company.location}</span>}
    </div>

    {company.roles.length > 1 && (
      <div class="role-tabs" role="tablist">
        {company.roles.map((r, i) => (
          <button role="tab" class={i === 0 ? 'active' : ''} data-role={i}>{r.title}</button>
        ))}
      </div>
    )}

    {company.roles.map((r, i) => (
      <div class="role" data-role-panel={i} hidden={i !== 0}>
        <div class="role-meta">
          <strong>{r.title}{r.type && <span class="badge">{r.type}</span>}</strong>
          <span class="muted">{r.period}</span>
        </div>
        <p class="summary">{r.summary}</p>

        <div class="chips" aria-label="Filter highlights by skill">
          {r.skills.map((s) => <button class="chip" data-skill={s} aria-pressed="false">{s}</button>)}
        </div>

        <ul class="highlights">
          {r.highlights.map((h) => (
            <li class="hl" data-skills={h.skills.join('|')}>
              <button class="hl-btn" aria-expanded="false">
                <span class="hl-title">{h.title}</span>
                <span class="plus" aria-hidden="true">+</span>
              </button>
              <div class="hl-detail"><div class="inner"><p>{h.detail}</p></div></div>
            </li>
          ))}
        </ul>
      </div>
    ))}
    </div>
    {company.mock && <aside class="co-mock"><Mock kind={company.mock} rich /></aside>}
  </div>
  ))}
</section>

<script>
  document.querySelectorAll<HTMLElement>('#experience .company').forEach((co) => {
    // Role tabs
    co.querySelectorAll<HTMLButtonElement>('.role-tabs button').forEach((tab) => {
      tab.addEventListener('click', () => {
        co.querySelectorAll('.role-tabs button').forEach((t) => t.classList.toggle('active', t === tab));
        co.querySelectorAll<HTMLElement>('[data-role-panel]').forEach((p) => {
          p.hidden = p.dataset.rolePanel !== tab.dataset.role;
        });
      });
    });

    // Expand / collapse highlights
    co.querySelectorAll<HTMLButtonElement>('.hl-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        btn.closest('.hl')!.classList.toggle('open', !open);
      });
    });

    // Skill chips: highlight matching items, dim the rest
    co.querySelectorAll<HTMLElement>('.role').forEach((role) => {
      const chips = role.querySelectorAll<HTMLButtonElement>('.chip');
      const items = role.querySelectorAll<HTMLElement>('.hl');
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const wasOn = chip.getAttribute('aria-pressed') === 'true';
          chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
          const skill = wasOn ? null : chip.dataset.skill!;
          if (skill) chip.setAttribute('aria-pressed', 'true');
          items.forEach((li) => {
            const match = !skill || li.dataset.skills!.split('|').includes(skill);
            li.classList.toggle('dim', !match);
            li.classList.toggle('match', !!skill && match);
          });
        });
      });
    });
  });
</script>

<style>
  .exp { padding: 4rem 0 2rem; border-top: 1px solid var(--line); }
  .exp > h2 { margin-bottom: 1.5rem; }
  .company + .company { margin-top: 1.25rem; }
  .company { border: 1px solid var(--line); border-radius: 14px; padding: clamp(1.25rem, 3vw, 2rem); background: var(--surface); }
  .company { display: grid; grid-template-columns: minmax(0, 1fr) minmax(15rem, 20rem); gap: clamp(1.25rem, 3vw, 2.5rem); align-items: start; }
  .co-mock { position: sticky; top: 6rem; border-radius: 10px; overflow: hidden; min-height: 22rem; display: grid; }
  .co-mock > :global(.frame) { border-radius: 10px; }
  @media (max-width: 53.75em) { .company { grid-template-columns: 1fr; } .co-mock { position: static; order: -1; min-height: 18rem; } }
  .company-head { display: flex; align-items: baseline; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .muted { color: var(--muted); font-size: var(--text-label); }
  .role-tabs { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
  .role-tabs button { background: none; border: 1px solid var(--line); color: var(--muted); padding: 0.4rem 0.9rem; border-radius: 999px; cursor: pointer; font: inherit; font-size: var(--text-label); }
  .role-tabs button.active { color: var(--fg); border-color: var(--fg); }
  .role-meta { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .badge { margin-left: 0.6rem; font-size: var(--text-caption); font-weight: 500; color: var(--accent); border: 1px solid var(--accent); border-radius: 999px; padding: 0.1rem 0.55rem; vertical-align: middle; white-space: nowrap; }
  .summary { color: var(--muted); margin: 0.5rem 0 1.2rem; max-width: 62ch; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.2rem; }
  .chip { font: inherit; font-size: var(--text-caption); font-weight: 500; color: var(--fg); background: var(--bg); border: 1px solid var(--line); border-radius: 999px; padding: 0.3rem 0.8rem; cursor: pointer; transition: background-color 0.2s, border-color 0.2s; white-space: nowrap; }
  .chip:hover { border-color: var(--fg); }
  .chip[aria-pressed='true'] { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
  .highlights { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .hl { border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: #fff; transition: opacity 0.25s, border-color 0.25s; }
  .hl.dim { opacity: 0.35; }
  .hl.match { border-color: var(--accent); }
  .hl-btn { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 1rem; background: none; border: 0; color: var(--fg); font: inherit; font-weight: 600; text-align: left; line-height: 1.4; padding: 0.9rem 1rem; cursor: pointer; }
  .hl-btn:hover { background: rgba(43, 43, 43, 0.04); }
  .plus { color: var(--accent); font-size: 1.3rem; line-height: 1; transition: transform 0.25s; }
  .hl.open .plus { transform: rotate(45deg); }
  .hl-detail { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.3s ease; }
  .hl.open .hl-detail { grid-template-rows: 1fr; }
  .hl-detail > .inner { overflow: hidden; padding: 0 1rem; }
  .hl-detail p { color: var(--muted); max-width: 62ch; }
  .hl.open .hl-detail > .inner { padding-bottom: 1rem; }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
