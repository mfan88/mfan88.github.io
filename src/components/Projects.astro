---
import { projects } from '../data/projects';
import Mock from './Mock.astro';
---
<section id="projects" class="proj">
  <h2>Projects</h2>
  {projects.map((p) => (
    <article class="card" id={`proj-${p.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
      <div class="co-main">
      <div class="card-head">
        {p.logo && <img src={p.logo} alt="" width="52" height="52" />}
        <div class="titles">
          <h3>{p.name}</h3>
          <p class="tag">{p.tagline}</p>
        </div>
        <span class="status">{p.status}</span>
      </div>
      <p class="summary">{p.summary}</p>
      <p class="built">{p.built}</p>

      <div class="chips" aria-label="Filter highlights by theme">
        {p.skills.map((s) => <button class="chip" data-skill={s} aria-pressed="false">{s}</button>)}
      </div>

      {p.groups.map((g) => (
        <div class="group">
          <h4>{g.label}</h4>
          <ul class="highlights">
            {g.highlights.map((h) => (
              <li class="hl" data-skills={h.skills.join('|')}>
                <button class="hl-btn" aria-expanded="false">
                  <span class="hl-title">{h.title}</span>
                  <span class="plus" aria-hidden="true">+</span>
                </button>
                <div class="hl-detail"><div class="inner">
                  <p>{h.detail}</p>
                </div></div>
              </li>
            ))}
          </ul>
        </div>
      ))}
      </div>
      {p.mock && <aside class="co-mock"><Mock kind={p.mock} rich /></aside>}
    </article>
  ))}
</section>

<script>
  document.querySelectorAll<HTMLElement>('#projects .card').forEach((card) => {
    card.querySelectorAll<HTMLButtonElement>('.hl-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        btn.closest('.hl')!.classList.toggle('open', !open);
      });
    });
    const chips = card.querySelectorAll<HTMLButtonElement>('.chip');
    const items = card.querySelectorAll<HTMLElement>('.hl');
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const wasOn = chip.getAttribute('aria-pressed') === 'true';
        chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
        const skill = wasOn ? null : chip.dataset.skill!;
        if (skill) chip.setAttribute('aria-pressed', 'true');
        items.forEach((li) => {
          const match = !skill || li.dataset.skills!.split('|').includes(skill);
          li.classList.toggle('dim', !match);
          li.classList.toggle('match', !!skill && match);
        });
      });
    });
  });
</script>

<style>
  .proj { scroll-margin-top: 4.5rem; padding: 4rem 0 2rem; border-top: 1px solid var(--line); }
  .proj > h2 { margin-bottom: 1.5rem; }
  .card + .card { margin-top: 1.25rem; }
  .card { scroll-margin-top: 5rem; border: 1px solid var(--line); border-radius: 14px; padding: clamp(1.25rem, 3vw, 2rem); background: var(--surface); }
  .card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 320px); gap: clamp(1.25rem, 3vw, 2.5rem); align-items: start; }
  .co-mock { position: sticky; top: 6rem; border-radius: 10px; overflow: hidden; min-height: 22rem; display: grid; }
  @media (max-width: 860px) { .card { grid-template-columns: 1fr; } .co-mock { position: static; order: -1; min-height: 18rem; } }
  .card-head { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .card-head img { border-radius: 12px; }
  .titles { flex: 1; min-width: 12rem; }
  .tag { color: var(--muted); font-size: var(--text-body); margin-top: 0.2rem; }
  .status { font-size: var(--text-caption); font-weight: 500; color: var(--fg); border: 1px solid var(--line); background: var(--bg); border-radius: 999px; padding: 0.25rem 0.8rem; white-space: nowrap; }
  .summary { color: var(--muted); margin: 1rem 0 0.4rem; max-width: 62ch; }
  .built { font-size: var(--text-caption); color: var(--muted); margin-bottom: 0.9rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.4rem; }
  .chip { font: inherit; font-size: var(--text-caption); font-weight: 500; color: var(--fg); background: var(--bg); border: 1px solid var(--line); border-radius: 999px; padding: 0.3rem 0.8rem; cursor: pointer; transition: background-color 0.2s, border-color 0.2s; white-space: nowrap; }
  .chip:hover { border-color: var(--fg); }
  .chip[aria-pressed='true'] { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
  .group { margin-bottom: 1.4rem; }
  h4 { font-size: var(--text-label); font-weight: 600; color: var(--muted); margin-bottom: 0.6rem; }
  .highlights { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .hl { border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: #fff; transition: opacity 0.25s, border-color 0.25s; }
  .hl.dim { opacity: 0.35; }
  .hl.match { border-color: var(--accent); }
  .hl-btn { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 1rem; background: none; border: 0; color: var(--fg); font: inherit; font-weight: 600; text-align: left; line-height: 1.4; padding: 0.9rem 1rem; cursor: pointer; }
  .hl-btn:hover { background: rgba(43, 43, 43, 0.04); }
  .plus { color: var(--accent); font-size: 1.3rem; line-height: 1; transition: transform 0.25s; }
  .hl.open .plus { transform: rotate(45deg); }
  .hl-detail { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.3s ease; }
  .hl.open .hl-detail { grid-template-rows: 1fr; }
  .hl-detail > .inner { overflow: hidden; padding: 0 1rem; }
  .hl-detail p { color: var(--muted); max-width: 62ch; }
  .hl.open .hl-detail > .inner { padding-bottom: 1rem; }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
