---
// One combined, Salesforce-Lightning-style "Quote Editor" mockup.
// Fictional data; illustrative only, not a screenshot of any real client system.
---
<dialog id="sf-modal" aria-labelledby="sf-title">
  <div class="sf">
    <header class="sf-head">
      <h4 id="sf-title">Quote Editor · Q-00127</h4>
      <button class="x" aria-label="Close" data-close>×</button>
    </header>

    <div class="tabs" role="tablist">
      <button role="tab" data-tab="bulk">Bulk editing</button>
      <button role="tab" data-tab="speed">Faster actions</button>
      <button role="tab" data-tab="errors">Error handling</button>
    </div>

    <section class="task">
      <div class="task-row">
        <p><strong>Try it:</strong> <span id="task-text"></span></p>
        <div class="seg" role="group" aria-label="Before or after" id="seg"></div>
      </div>
      <p class="hint" id="task-hint"></p>
      <div class="stats">
        <span>⏱ <b id="st-time">0.0s</b></span>
        <span>Actions: <b id="st-actions">0</b></span>
        <span id="st-status" class="status-msg" aria-live="polite"></span>
        <button class="link-btn" id="reset">Reset</button>
      </div>
      <p class="results" id="results"></p>
    </section>

    <div class="banner" id="banner" hidden role="alert"></div>

    <div class="bulkbar" id="bulkbar" hidden>
      <span><b id="sel-count">0</b> selected</span>
      <label>Set discount to <input type="number" id="bulk-val" value="15" min="0" /> %</label>
      <button class="btn brand" id="bulk-apply">Apply to selected</button>
    </div>

    <div class="tbl-wrap">
      <table id="tbl">
        <thead>
          <tr>
            <th class="sel"><input type="checkbox" id="sel-all" aria-label="Select all lines" /></th>
            <th>Product</th><th>Qty</th><th>List</th><th>Disc %</th><th class="r">Net</th>
          </tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
    </div>

    <div class="savebar">
      <div>Quote total <strong id="total"></strong></div>
      <div class="save-right"><span id="toast" class="toast" hidden></span><button class="btn brand" id="save">Save</button></div>
    </div>

    <footer class="sf-foot">
      <span class="note">Illustrative mockup · fictional data · delays are simulated</span>
      <button class="btn" data-close>Close</button>
    </footer>
  </div>
</dialog>

<script>
  type TabKey = 'bulk' | 'speed' | 'errors';
  interface Line { name: string; qty: number; price: number; disc: number }

  const INITIAL: Line[] = [
    { name: 'Platform License', qty: 10, price: 120, disc: 10 },
    { name: 'Implementation Services', qty: 40, price: 150, disc: 0 },
    { name: 'Premium Support', qty: 1, price: 2400, disc: 5 },
    { name: 'Training Package', qty: 5, price: 800, disc: 0 },
    { name: 'Data Migration', qty: 2, price: 3500, disc: 10 },
    { name: 'Admin Add-on', qty: 8, price: 300, disc: 0 },
  ];
  const MAX_DISC = 25;
  const LAG_MS = 900;

  const TABS: Record<TabKey, { task: string; hint: string; modes: [string, string]; timed: boolean }> = {
    bulk: {
      task: 'Set the discount on all 6 lines to 15%.',
      hint: 'Bulk edit lets you select lines and apply one change to all of them at once.',
      modes: ['One by one', 'Bulk edit'],
      timed: true,
    },
    speed: {
      task: 'Set the quantity on the first 3 lines to 5, then press Save.',
      hint: '“Before fixes” simulates the lag between actions that the bug fixes removed.',
      modes: ['Before fixes', 'After fixes'],
      timed: true,
    },
    errors: {
      task: `Enter a 40% discount on any line, then press Save.`,
      hint: 'Notice what the user is told, and whether they would know how to fix it.',
      modes: ['Before', 'After'],
      timed: false,
    },
  };

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const dlg = $<HTMLDialogElement>('#sf-modal');
  const rowsEl = $('#rows'), tbl = $('#tbl'), banner = $('#banner'), bulkbar = $('#bulkbar');
  const selAll = $<HTMLInputElement>('#sel-all'), bulkVal = $<HTMLInputElement>('#bulk-val');
  const saveBtn = $<HTMLButtonElement>('#save');
  const money = (n: number) => '$' + n.toLocaleString(undefined, { maximumFractionDigits: 0 });

  let tab: TabKey = 'bulk';
  const mode: Record<TabKey, 0 | 1> = { bulk: 0, speed: 0, errors: 0 };
  const results: Record<string, { t: number; n: number }> = {};
  let lines: Line[] = [];
  let errors: Record<number, string> = {};
  let selected = new Set<number>();
  let actions = 0, startedAt: number | null = null, finished = false, saved = false;
  let busy = false, tick: number | undefined, bannerShown = false;

  const lag = () => (tab === 'speed' && mode.speed === 0 ? LAG_MS : 0);
  const bulkOn = () => tab === 'bulk' && mode.bulk === 1;
  const friendly = () => tab !== 'errors' || mode.errors === 1;

  // ---- build rows once ----
  INITIAL.forEach((_, i) => {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td class="sel"><input type="checkbox" data-i="${i}" aria-label="Select line ${i + 1}" /></td>
      <td><div class="pname"></div><div class="msg" hidden></div></td>
      <td><input type="number" data-f="qty" data-i="${i}" aria-label="Quantity" /></td>
      <td class="list"></td>
      <td><input type="number" data-f="disc" data-i="${i}" aria-label="Discount percent" /></td>
      <td class="r net"></td>`;
    rowsEl.appendChild(tr);
  });
  const rowEls = [...rowsEl.querySelectorAll('tr')];

  // ---- state helpers ----
  function validate(i: number) {
    const l = lines[i];
    let msg = '';
    if (!Number.isFinite(l.qty) || l.qty < 1) msg = 'Quantity must be at least 1.';
    else if (l.disc < 0) msg = 'Discount can’t be negative.';
    else if (l.disc > MAX_DISC)
      msg = `Discount of ${l.disc}% exceeds the ${MAX_DISC}% limit without approval. Enter ${MAX_DISC}% or less.`;
    if (msg) errors[i] = msg; else delete errors[i];
  }

  function refresh() {
    let total = 0;
    rowEls.forEach((tr, i) => {
      const l = lines[i];
      const q = tr.querySelector<HTMLInputElement>('[data-f=qty]')!;
      const d = tr.querySelector<HTMLInputElement>('[data-f=disc]')!;
      if (document.activeElement !== q) q.value = Number.isFinite(l.qty) ? String(l.qty) : '';
      if (document.activeElement !== d) d.value = Number.isFinite(l.disc) ? String(l.disc) : '';
      q.readOnly = d.readOnly = busy;
      tr.querySelector('.pname')!.textContent = l.name;
      tr.querySelector('.list')!.textContent = money(l.price);
      const net = (l.qty || 0) * l.price * (1 - (l.disc || 0) / 100);
      total += net;
      tr.querySelector('.net')!.textContent = busy ? '…' : money(net);
      const show = friendly() && !!errors[i];
      q.classList.toggle('bad', show && /Quantity/.test(errors[i]));
      d.classList.toggle('bad', show && !/Quantity/.test(errors[i]));
      const m = tr.querySelector<HTMLElement>('.msg')!;
      m.hidden = !show;
      m.textContent = show ? errors[i] : '';
      tr.querySelector<HTMLInputElement>('.sel input')!.checked = selected.has(i);
    });
    $('#total').textContent = busy ? '…' : money(total);
    tbl.classList.toggle('bulk-on', bulkOn());
    tbl.classList.toggle('busy', busy);
    bulkbar.hidden = !bulkOn();
    $('#sel-count').textContent = String(selected.size);
    selAll.checked = selected.size === lines.length;
    const nErr = Object.keys(errors).length;
    const block = friendly() && nErr > 0;
    saveBtn.disabled = busy || block;
    saveBtn.textContent = busy ? 'Working…' : block ? `Fix ${nErr} issue${nErr > 1 ? 's' : ''} to save` : 'Save';
    banner.hidden = !(bannerShown && !friendly() && nErr > 0);
  }

  function renderStats() {
    const secs = startedAt ? ((finished ? stopAt : performance.now()) - startedAt) / 1000 : 0;
    $('#st-time').textContent = secs.toFixed(1) + 's';
    $('#st-actions').textContent = String(actions);
  }
  let stopAt = 0;

  function renderResults() {
    const cfg = TABS[tab];
    const parts = ([0, 1] as const)
      .map((m) => ({ m, r: results[`${tab}${m}`] }))
      .filter((x) => x.r)
      .map((x) => `<span class="res${x.m === mode[tab] ? ' cur' : ''}">${cfg.modes[x.m]}: <b>${x.r.t.toFixed(1)}s</b> · ${x.r.n} action${x.r.n === 1 ? '' : 's'}</span>`);
    $('#results').innerHTML = cfg.timed && parts.length ? 'Your results: ' + parts.join('') : '';
  }

  function startTimer() {
    if (startedAt) return;
    startedAt = performance.now();
    tick = window.setInterval(renderStats, 100);
  }

  function taskComplete() {
    if (tab === 'bulk') return lines.every((l) => l.disc === 15);
    if (tab === 'speed') return saved && lines.slice(0, 3).every((l) => l.qty === 5);
    return false;
  }
  function checkDone() {
    if (finished || busy || !startedAt || !TABS[tab].timed || !taskComplete()) return;
    finished = true;
    stopAt = performance.now();
    clearInterval(tick);
    const t = (stopAt - startedAt) / 1000;
    results[`${tab}${mode[tab]}`] = { t, n: actions };
    renderStats();
    $('#st-status').textContent = '✓ Task complete';
    renderResults();
  }

  function runBusy(ms: number, then: () => void) {
    if (!ms) { then(); refresh(); checkDone(); return; }
    busy = true; refresh();
    window.setTimeout(() => { busy = false; then(); refresh(); checkDone(); }, ms);
  }

  function reset() {
    clearInterval(tick);
    lines = INITIAL.map((l) => ({ ...l }));
    errors = {}; selected = new Set();
    actions = 0; startedAt = null; finished = false; saved = false; busy = false; bannerShown = false;
    $('#st-status').textContent = '';
    $('#toast').hidden = true;
    renderStats(); renderResults(); refresh();
  }

  function setTab(t: TabKey) {
    tab = t;
    const cfg = TABS[t];
    dlg.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === t)));
    $('#task-text').textContent = cfg.task;
    $('#task-hint').textContent = cfg.hint;
    $('#seg').innerHTML = cfg.modes.map((label, i) => `<button data-mode="${i}" aria-pressed="${mode[t] === i}">${label}</button>`).join('');
    dlg.querySelectorAll<HTMLElement>('.stats').forEach((s) => (s.hidden = !cfg.timed));
    reset();
  }

  // ---- events ----
  $('#seg').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-mode]');
    if (!b) return;
    mode[tab] = +b.dataset.mode! as 0 | 1;
    setTab(tab);
  });
  dlg.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => setTab(b.dataset.tab as TabKey)));
  $('#reset').addEventListener('click', reset);

  rowsEl.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (!el.dataset.f) return;
    startTimer();
    const i = +el.dataset.i!;
    const v = el.value === '' ? NaN : +el.value;
    (lines[i] as any)[el.dataset.f] = v;
    validate(i);
    bannerShown = false;
    refresh();
  });
  rowsEl.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.dataset.f) {
      actions++; renderStats();
      runBusy(lag(), () => {});
    } else if (el.type === 'checkbox') {
      const i = +el.dataset.i!;
      el.checked ? selected.add(i) : selected.delete(i);
      refresh();
    }
  });
  selAll.addEventListener('change', () => {
    selected = selAll.checked ? new Set(lines.map((_, i) => i)) : new Set();
    refresh();
  });
  $('#bulk-apply').addEventListener('click', () => {
    if (!selected.size) return;
    startTimer();
    const v = +bulkVal.value;
    selected.forEach((i) => { lines[i].disc = v; validate(i); });
    actions++; renderStats();
    refresh(); checkDone();
  });

  saveBtn.addEventListener('click', () => {
    startTimer();
    actions++; renderStats();
    if (Object.keys(errors).length) { bannerShown = true; banner.textContent = 'An error occurred. Please contact your administrator.'; refresh(); return; }
    runBusy(lag(), () => {
      saved = true;
      const t = $('#toast'); t.textContent = '✓ Quote saved'; t.hidden = false;
    });
  });

  // ---- open / close ----
  function open(name: string) {
    setTab((name in TABS ? name : 'bulk') as TabKey);
    dlg.showModal();
  }
  document.querySelectorAll<HTMLElement>('.demo-btn').forEach((b) => b.addEventListener('click', () => open(b.dataset.demo!)));
  dlg.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => dlg.close()));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('close', () => clearInterval(tick));
  setTab('bulk');
</script>

<style is:global>
  #sf-modal { border: 0; padding: 0; background: none; max-width: 100vw; margin: auto; }
  #sf-modal::backdrop { background: rgba(8, 10, 16, 0.7); backdrop-filter: blur(4px); }
  /* Light, Lightning-esque palette, deliberately separate from the dark site */
  #sf-modal .sf { --blue: #0176d3; --bd: #dddbda; --tx: #181818; --mu: #5c5c5c; --red: #ba0517; --green: #2e844a;
    width: min(760px, 95vw); max-height: 92vh; overflow: auto; background: #fff; color: var(--tx);
    border-radius: 0.5rem; font-size: 0.9rem; font-family: ui-sans-serif, system-ui, sans-serif; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
  #sf-modal [hidden] { display: none !important; }
  #sf-modal .sf-head { display: flex; justify-content: space-between; align-items: center; padding: 0.9rem 1.2rem; border-bottom: 1px solid var(--bd); background: #f3f3f3; border-radius: 0.5rem 0.5rem 0 0; }
  #sf-modal h4 { font-size: 1.1rem; font-weight: 600; }
  #sf-modal .x { background: none; border: 0; font-size: 1.6rem; line-height: 1; cursor: pointer; color: var(--mu); }
  #sf-modal .tabs { display: flex; border-bottom: 1px solid var(--bd); padding: 0 0.6rem; overflow-x: auto; }
  #sf-modal .tabs button { font: inherit; background: none; border: 0; border-bottom: 3px solid transparent; padding: 0.7rem 1rem; color: var(--mu); cursor: pointer; white-space: nowrap; }
  #sf-modal .tabs button[aria-selected='true'] { color: var(--blue); border-bottom-color: var(--blue); font-weight: 600; }
  #sf-modal .task { padding: 1rem 1.2rem 0.4rem; }
  #sf-modal .task-row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  #sf-modal .hint { color: var(--mu); font-size: 0.82rem; margin: 0.4rem 0 0; }
  #sf-modal .stats { display: flex; gap: 1.2rem; align-items: center; margin-top: 0.7rem; font-size: 0.85rem; flex-wrap: wrap; }
  #sf-modal .status-msg { color: var(--green); font-weight: 600; }
  #sf-modal .link-btn { margin-left: auto; font: inherit; background: none; border: 0; color: var(--blue); cursor: pointer; }
  #sf-modal .results { margin: 0.4rem 0 0; font-size: 0.82rem; color: var(--mu); display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; min-height: 0; }
  #sf-modal .results:empty { display: none; }
  #sf-modal .res { background: #f3f3f3; border-radius: 999px; padding: 0.15rem 0.7rem; }
  #sf-modal .res.cur { background: #e1f0fc; color: #014486; }
  #sf-modal .seg { display: inline-flex; border: 1px solid var(--blue); border-radius: 4px; overflow: hidden; }
  #sf-modal .seg button { font: inherit; padding: 0.35rem 0.9rem; border: 0; background: #fff; color: var(--blue); cursor: pointer; }
  #sf-modal .seg button[aria-pressed='true'] { background: var(--blue); color: #fff; }
  #sf-modal .banner { margin: 0.8rem 1.2rem 0; padding: 0.7rem 1rem; background: #fde9e7; color: var(--red); border: 1px solid #f5b5ae; border-radius: 4px; font-weight: 600; }
  #sf-modal .bulkbar { margin: 0.8rem 1.2rem 0; padding: 0.6rem 1rem; background: #e1f0fc; border-radius: 4px; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  #sf-modal .bulkbar input { width: 4rem; padding: 0.3rem 0.4rem; border: 1px solid #c9c7c5; border-radius: 4px; font: inherit; }
  #sf-modal .tbl-wrap { padding: 0.6rem 1.2rem; overflow-x: auto; }
  #sf-modal table { width: 100%; border-collapse: collapse; min-width: 480px; }
  #sf-modal th { text-align: left; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--mu); background: #fafaf9; }
  #sf-modal th, #sf-modal td { padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--bd); vertical-align: top; }
  #sf-modal .r { text-align: right; }
  #sf-modal table:not(.bulk-on) .sel { display: none; }
  #sf-modal table.busy { opacity: 0.6; }
  #sf-modal td input[type='number'] { width: 4.2rem; padding: 0.3rem 0.4rem; border: 1px solid #c9c7c5; border-radius: 4px; font: inherit; }
  #sf-modal td input:focus { outline: 2px solid var(--blue); outline-offset: 0; }
  #sf-modal td input.bad { border-color: var(--red); background: #fef5f4; }
  #sf-modal .msg { color: var(--red); font-size: 0.78rem; margin-top: 0.2rem; max-width: 22ch; }
  #sf-modal .savebar { display: flex; justify-content: space-between; align-items: center; padding: 0.4rem 1.2rem 1rem; flex-wrap: wrap; gap: 0.6rem; }
  #sf-modal .save-right { display: flex; align-items: center; gap: 0.8rem; }
  #sf-modal .toast { color: var(--green); font-weight: 600; }
  #sf-modal .btn { font: inherit; padding: 0.45rem 1rem; border-radius: 4px; border: 1px solid var(--bd); background: #fff; color: var(--blue); cursor: pointer; }
  #sf-modal .btn.brand { background: var(--blue); color: #fff; border-color: var(--blue); }
  #sf-modal .btn:disabled { opacity: 0.55; cursor: not-allowed; }
  #sf-modal .sf-foot { display: flex; justify-content: space-between; align-items: center; padding: 0.8rem 1.2rem; border-top: 1px solid var(--bd); background: #f3f3f3; border-radius: 0 0 0.5rem 0.5rem; gap: 1rem; }
  #sf-modal .note { color: var(--mu); font-size: 0.78rem; }
</style>
