---
import Base from '../layouts/Base.astro';
import Experience from '../components/Experience.astro';

const links = {
  linkedin: 'https://www.linkedin.com/in/marcusfan888/',
  github: 'https://github.com/mfan88',
};
const nav = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---
<Base title="Marcus Fan — Portfolio">
  <header class="site-header">
    <a class="logo" href="#top">MF<span>.</span></a>
    <nav>
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a class="pill" href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <p class="eyebrow">West Vancouver, BC</p>
      <h1>Hi, I'm <span class="grad">Marcus Fan</span>.</h1>
      <p class="lead">I build things for the web. This is a work in progress — more coming soon.</p>
      <div class="cta">
        <a class="btn primary" href={links.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn</a>
        <a class="btn" href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </section>

    <section id="about"><h2>About</h2><p class="muted">Placeholder — a short intro goes here.</p></section>
    <Experience />
    <section id="projects"><h2>Projects</h2><p class="muted">Placeholder — selected work goes here.</p></section>
    <section id="contact">
      <h2>Contact</h2>
      <p class="muted">Find me on <a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a> or <a href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>.</p>
    </section>
  </main>

  <footer>© {new Date().getFullYear()} Marcus Fan</footer>
</Base>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 10;
    display: flex; justify-content: space-between; align-items: center;
    padding: 1rem clamp(1.25rem, 5vw, 4rem);
    backdrop-filter: blur(14px); background: rgba(11, 13, 18, 0.6);
    border-bottom: 1px solid var(--line);
  }
  .logo { font-weight: 800; font-size: 1.3rem; color: var(--fg); text-decoration: none; letter-spacing: -0.02em; }
  .logo span { color: var(--accent); }
  nav { display: flex; gap: 1.4rem; align-items: center; }
  nav a { color: var(--muted); text-decoration: none; font-size: 0.95rem; transition: color 0.2s; }
  nav a:hover { color: var(--fg); }
  nav .pill {
    color: var(--fg); padding: 0.4rem 0.9rem; border-radius: 999px;
    border: 1px solid var(--line); background: rgba(255, 255, 255, 0.04);
  }
  nav .pill:hover { border-color: var(--accent); }
  section { scroll-margin-top: 4.5rem; }
  main { padding: 0 clamp(1.25rem, 5vw, 4rem); max-width: 1100px; margin: 0 auto; }
  .hero { min-height: 80vh; display: flex; flex-direction: column; justify-content: center; gap: 1.2rem; }
  .eyebrow { color: var(--accent); font-family: ui-monospace, monospace; font-size: 0.9rem; }
  h1 { font-size: clamp(2.6rem, 8vw, 5.5rem); line-height: 1.05; letter-spacing: -0.03em; }
  .grad { background: linear-gradient(90deg, var(--accent), var(--accent2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lead { color: var(--muted); font-size: 1.2rem; max-width: 40ch; }
  .cta { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 0.6rem; }
  .btn {
    padding: 0.75rem 1.4rem; border-radius: 12px; text-decoration: none; color: var(--fg);
    border: 1px solid var(--line); transition: transform 0.2s, border-color 0.2s;
  }
  .btn:hover { transform: translateY(-2px); border-color: var(--accent); }
  .btn.primary { background: linear-gradient(90deg, var(--accent), var(--accent2)); color: #0b0d12; font-weight: 600; border: none; }
  section:not(.hero) { padding: 4rem 0; border-top: 1px solid var(--line); }
  h2 { font-size: 1.8rem; margin-bottom: 0.8rem; }
  .muted { color: var(--muted); }
  .muted a { color: var(--accent); }
  footer { text-align: center; color: var(--muted); padding: 3rem 1rem; font-size: 0.85rem; }
  @media (max-width: 560px) { nav a:not(.pill) { display: none; } }
</style>
